# Resend email configuration
# Add your Resend API key here: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# The from address used when sending website form emails.
# This must use a domain verified in your Resend account.
# Example: Samrik Solutions <info@samrik.co.in>
RESEND_FROM_EMAIL=Samrik Solutions <info@samrik.co.in>
